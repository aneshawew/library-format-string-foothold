# {{ ansible_managed }}
[Unit]
Description=SEED Labs format-string vulnerable UDP daemon
After=network.target

[Service]
Type=simple
# Root daemon, per the lab's own design (the exercise's objective is
# privilege escalation to root via this exact vulnerability). This is a
# single, per-student VM - not shared multi-tenant infrastructure - so
# the blast radius of a successful exploit is the student's own sandbox.
# See INSTRUCTOR_NOTES.md.
User=root
WorkingDirectory=/opt/format
# stdbuf -o0: this binary never exits (infinite recvfrom loop), so its
# stdout would otherwise sit fully buffered and not reach `journalctl`
# until the buffer happens to fill - verified in testing. See
# INSTRUCTOR_NOTES.md.
ExecStart=/usr/bin/stdbuf -o0 /opt/format/server
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
